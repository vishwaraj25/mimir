# Mimir's own database (investigations, insights, experiments, briefs).
# Create a fresh Postgres database for this -- it is NOT the game's database.
MIMIR_DATABASE_URL=

# Connected telemetry source: Night Run.
# Use a READ-ONLY Postgres role. Mimir never writes to a source.
SOURCE_NIGHT_RUN_URL=

# Anthropic API key, for the agent.
ANTHROPIC_API_KEY=

# Protects the dashboard and the cron endpoint.
MIMIR_ACCESS_KEY=
