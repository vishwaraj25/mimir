# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no configuration at all, Mimir runs
# against a synthetic telemetry source and in-memory storage, so the whole
# app works on a fresh clone -- you just cannot run the agent without a model.
# ---------------------------------------------------------------------------

# --- model (pick ONE; the first three are free) -----------------------------

# Google Gemini. Free, but only about 5 requests/min and ~20/day: roughly one
# investigation a day. Fine for the morning brief; prefer Groq or Ollama for more.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Groq. Free tier, very fast. Key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # free tier: 8k tokens/min, 200k tokens/day

# Ollama, running locally. Free forever, and no telemetry leaves your machine.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Paid options, if you ever want them.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Force a specific provider when several keys are present.
# LLM_PROVIDER=gemini

# --- storage ----------------------------------------------------------------
# Where Mimir keeps investigations, insights, experiments and briefs.
# Omit it and everything is kept in memory and lost on restart.
# Run db/schema.sql against this database once.
MIMIR_DATABASE_URL=

# --- telemetry sources ------------------------------------------------------
# A READ-ONLY Postgres role on the product you want analysed.
# Omit it and the synthetic demo source is used instead.
SOURCE_NIGHT_RUN_URL=

# --- access -----------------------------------------------------------------
# Protects the API routes. Leave unset for local development.
MIMIR_ACCESS_KEY=
